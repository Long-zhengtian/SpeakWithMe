# Optional developer override. The settings page is where a key is normally entered.
# auto: openai_compatible when LLM_API_KEY is set, otherwise the app waits for a key.
LLM_PROVIDER=auto
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional cheaper models. Empty means LLM_MODEL is used.
LLM_CORRECTION_MODEL=
LLM_COACH_MODEL=

# Register a class in STT_BUILDERS / TTS_BUILDERS, then set the name here.
STT_PROVIDER=none
TTS_PROVIDER=none

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# memory or sqlite. sqlite keeps practice records on this computer.
REPOSITORY=sqlite
# DATA_PATH=backend/data/speaking.sqlite
